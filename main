-- ============================================================
-- MUCAN HUB - KEY SYSTEM (PRODUCTION)
-- Cek lisensi dulu, baru bikin UI kalau perlu
-- ============================================================

-- ============================================================
-- SERVICES
-- ============================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Camera = workspace.CurrentCamera
local TeleportService = game:GetService("TeleportService")

-- ============================================================
-- CONFIG
-- ============================================================

local API_URL = "https://keysystem-lac.vercel.app"
local WEB_URL = "https://keysystem-lac.vercel.app"
local KEY_CACHE_FILE = "mucan_hub_key.txt"

-- ============================================================
-- AUTO-DETECT GAME NAME
-- ============================================================

local function getGameName()
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if ok and info and info.Name then
        return info.Name
    end
    return "Unknown Game"
end

local gameName = getGameName()

-- ============================================================
-- ANTI-DOUBLE
-- ============================================================

local function cleanAllUI()
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    if getgenv().MucanKeyWindow then
        pcall(function() getgenv().MucanKeyWindow:Destroy() end)
        getgenv().MucanKeyWindow = nil
    end

    if getgenv().MucanFloatingGui then
        pcall(function() getgenv().MucanFloatingGui:Destroy() end)
        getgenv().MucanFloatingGui = nil
    end

    local function cleanGui(parent)
        if not parent then return end
        for _, gui in ipairs(parent:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local name = string.lower(gui.Name)
                if string.find(name, "windui")
                   or string.find(name, "mucan")
                   or string.find(name, "hub")
                   or string.find(name, "floating") then
                    pcall(function() gui:Destroy() end)
                end
            end
        end
    end

    pcall(function() cleanGui(PlayerGui) end)
    pcall(function() cleanGui(CoreGui) end)
end

cleanAllUI()

-- ============================================================
-- KEY SYSTEM FUNCTIONS
-- ============================================================

local function getHWID()
    if gethwid then
        local ok, hwid = pcall(gethwid)
        if ok and hwid then return hwid end
    end
    if syn and syn.get_hwid then
        local ok, hwid = pcall(syn.get_hwid)
        if ok and hwid then return hwid end
    end
    return "ROBLOX-" .. tostring(LocalPlayer.UserId)
end

local function httpRequest(endpoint, method, body)
    local url = API_URL .. endpoint
    local req = syn and syn.request or http_request or request

    if not req then
        return nil, "no_request"
    end

    local ok, response = pcall(req, {
        Url = url,
        Method = method or "GET",
        Headers = {
            ["Content-Type"] = "application/json",
            ["User-Agent"] = "MucanHub/1.0",
        },
        Body = body and HttpService:JSONEncode(body) or nil,
    })

    if not ok then
        return nil, "req_failed"
    end

    if response.StatusCode ~= 200 then
        return nil, "http_" .. tostring(response.StatusCode)
    end

    local ok2, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not ok2 then return nil, "invalid_json" end
    return data, nil
end

local function verifyLicense()
    return httpRequest("/auth/verify", "POST", {
        userId = tostring(LocalPlayer.UserId),
        hwid = getHWID(),
    })
end

local function redeemKey(key)
    return httpRequest("/auth/redeem", "POST", {
        userId = tostring(LocalPlayer.UserId),
        hwid = getHWID(),
        key = key,
    })
end

-- Key cache
local function saveKeyToCache(key)
    if writefile then pcall(writefile, KEY_CACHE_FILE, key) end
end

local function loadKeyFromCache()
    if isfile and readfile then
        local ok, key = pcall(function()
            if isfile(KEY_CACHE_FILE) then return readfile(KEY_CACHE_FILE) end
            return nil
        end)
        if ok and key and key ~= "" then return key end
    end
    return nil
end

local function clearKeyCache()
    if delfile then pcall(delfile, KEY_CACHE_FILE) end
end

-- ============================================================
-- ON LICENSE VALID
-- ============================================================

local function onLicenseValid(data)
    getgenv().LicenseValidated = true
    getgenv().LicenseData = data

    if getgenv().MucanKeyWindow or getgenv().MucanFloatingGui then
        task.wait(0.5)
    end

    pcall(function()
        if getgenv().MucanKeyWindow then
            getgenv().MucanKeyWindow:Destroy()
            getgenv().MucanKeyWindow = nil
        end
    end)

    pcall(function()
        if getgenv().MucanFloatingGui then
            getgenv().MucanFloatingGui:Destroy()
            getgenv().MucanFloatingGui = nil
        end
    end)

    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    local function cleanGui(parent)
        if not parent then return end
        for _, gui in ipairs(parent:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local name = string.lower(gui.Name)
                if string.find(name, "windui")
                   or string.find(name, "mucan")
                   or string.find(name, "hub")
                   or string.find(name, "floating") then
                    pcall(function() gui:Destroy() end)
                end
            end
        end
    end

    pcall(function() cleanGui(PlayerGui) end)
    pcall(function() cleanGui(CoreGui) end)

    task.wait(0.2)

    local GAMES = {
        [134719268825886] = "https://raw.githubusercontent.com/whyudontteachme/mc-hub/refs/heads/main/test",
    }

    local scriptUrl = GAMES[game.PlaceId]

    if not scriptUrl then
        LocalPlayer:Kick("Game ini tidak didukung oleh script Mucan Hub.")
        return
    end

    local ok, err = pcall(function()
        loadstring(game:HttpGet(scriptUrl))()
    end)

    if not ok then
        LocalPlayer:Kick("Script error: gagal load module.")
    end
end

-- ============================================================
-- BUILDER: KEY SYSTEM UI
-- ============================================================

local WindUI = nil

local function buildKeySystemUI()
    local Version = "1.6.66"
    WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/download/" .. Version .. "/main.lua"))()

    WindUI:SetNotificationLower(true)
    WindUI:SetFont("rbxassetid://129455800774934")

    local MUGI_LOGO = "rbxassetid://109192347956156"
    local DISPLAY_FLOATING = 2147483647

    local function getParentGui()
        if gethui then
            local ok, hui = pcall(gethui)
            if ok and hui then return hui end
        end
        local ok, cg = pcall(function() return CoreGui end)
        if ok and cg then return cg end
        return LocalPlayer:WaitForChild("PlayerGui")
    end

    local parentGui = getParentGui()

    local FloatingGui = Instance.new("ScreenGui")
    FloatingGui.Name = "MucanFloatingButton"
    FloatingGui.ResetOnSpawn = false
    FloatingGui.DisplayOrder = DISPLAY_FLOATING
    FloatingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    FloatingGui.IgnoreGuiInset = true
    FloatingGui.Parent = parentGui

    getgenv().MucanFloatingGui = FloatingGui

    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(0, 60, 0, 60)
    Container.Position = UDim2.new(0, 20, 0.5, -30)
    Container.BackgroundTransparency = 1
    Container.Parent = FloatingGui

    local UIScale = Instance.new("UIScale")
    UIScale.Parent = Container

    local LogoButton = Instance.new("ImageButton")
    LogoButton.Size = UDim2.new(1, 0, 1, 0)
    LogoButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    LogoButton.BackgroundTransparency = 0.2
    LogoButton.Image = MUGI_LOGO
    LogoButton.BorderSizePixel = 0
    LogoButton.Parent = Container

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 12)
    UICorner.Parent = LogoButton

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Thickness = 2
    UIStroke.Color = Color3.fromRGB(0, 170, 255)
    UIStroke.Transparency = 0.2
    UIStroke.Parent = LogoButton

    local function updateUIScale()
        local viewport = Camera.ViewportSize
        local isMobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
        local scale = math.min(viewport.X / 1920, viewport.Y / 1080)
        scale = math.clamp(scale, 0.7, 1.5)
        if isMobile then scale = scale * 1.3 end
        UIScale.Scale = scale
    end

    updateUIScale()
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        task.wait(0.1)
        updateUIScale()
    end)

    local dragging, dragStart, startPos = false, nil, nil

    LogoButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Container.Position
        end
    end)

    LogoButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Container.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    local clickStart = nil
    LogoButton.MouseButton1Down:Connect(function() clickStart = tick() end)

    LogoButton.MouseButton1Click:Connect(function()
        local held = tick() - (clickStart or 0)
        if held < 0.3 then
            if getgenv().MucanKeyWindow then
                pcall(function()
                    local win = getgenv().MucanKeyWindow
                    if win.Toggle then win:Toggle()
                    elseif win.Minimize then win:Minimize() end
                end)
            end
        end
    end)

    local KeyWindow = WindUI:CreateWindow({
        Title = "Mucan HUB - License",
        Icon = "key",
        Author = gameName,
        Folder = "mucan-hub/keysystem",
        Size = UDim2.fromOffset(420, 320),
        Transparent = true,
        Theme = "Dark",
        Resizable = false,
        SideBarWidth = 120,
        HideSearchBar = true,
        ScrollBarEnabled = true,
        ToggleKey = Enum.KeyCode.K,
    })

    KeyWindow:EditOpenButton({Enabled = false})
    KeyWindow:DisableTopbarButtons({
        "Close",
        "Fullscreen",
    })

    getgenv().MucanKeyWindow = KeyWindow

    task.spawn(function()
        task.wait(0.5)
        local parent = (gethui and gethui()) or CoreGui
        for _, gui in ipairs(parent:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "MucanFloatingButton" then
                pcall(function()
                    gui.DisplayOrder = 999999
                    gui.GuiInset = true
                end)
            end
        end
    end)

    local KeyTab = KeyWindow:Tab({ Title = "License", Icon = "key" })
    local KeySection = KeyTab:Section({ Title = "Key System", Box = true, Opened = true })

    local statusLabel = KeySection:Paragraph({
        Title = "Status",
        Desc = "Menunggu verifikasi key...",
    })

    local infoLabel = KeySection:Paragraph({
        Title = "Info",
        Desc = "-",
    })

    local KeyInput = KeySection:Input({
        Title = "License Key",
        Desc = "Masukkan key dari web",
        Value = "",
        Callback = function(value) end,
    })

    KeySection:Button({
        Title = "Buka Web Key System",
        Desc = "Copy link buat dapetin key",
        Callback = function()
            local link = WEB_URL .. "/?userId=" .. tostring(LocalPlayer.UserId)
            if setclipboard then
                setclipboard(link)
                WindUI:Notify({
                    Title = "Link Copied",
                    Content = "Buka di browser",
                    Duration = 8
                })
            else
                WindUI:Notify({
                    Title = "Link",
                    Content = link,
                    Duration = 15
                })
            end
        end,
    })

    KeySection:Button({
        Title = "Verify Key",
        Desc = "Cek license key kamu",
        Callback = function()
            local key = KeyInput.Value
            if not key or key == "" then
                WindUI:Notify({ Title = "Error", Content = "Masukkan key dulu!", Duration = 3 })
                return
            end

            key = string.gsub(key, "^%s+", "")
            key = string.gsub(key, "%s+$", "")
            key = string.upper(key)

            WindUI:Notify({ Title = "Checking", Content = "Verifying...", Duration = 2 })

            task.spawn(function()
                local data, err = redeemKey(key)

                if not data then
                    WindUI:Notify({ Title = "Error", Content = "Koneksi gagal", Duration = 5 })
                    return
                end

                if data.status == "valid" then
                    saveKeyToCache(key)

                    WindUI:Notify({
                        Title = "Success",
                        Content = string.format("License aktif! (%d jam)", data.hours_left or 8),
                        Duration = 3
                    })

                    statusLabel:SetDesc("License Valid")
                    infoLabel:SetDesc(string.format("Expires: %s", data.expires_at or "-"))

                    onLicenseValid(data)
                else
                    WindUI:Notify({
                        Title = "Error",
                        Content = data.message or "Key invalid",
                        Duration = 5
                    })
                end
            end)
        end,
    })

    KeySection:Button({
        Title = "Logout / Clear Key",
        Desc = "Hapus key yang tersimpan",
        Callback = function()
            clearKeyCache()
            getgenv().LicenseValidated = false
            getgenv().LicenseData = nil
            statusLabel:SetDesc("Belum ada key")
            infoLabel:SetDesc("-")
            WindUI:Notify({ Title = "Logged Out", Content = "Key cache dihapus", Duration = 3 })
        end,
    })
end

-- ============================================================
-- BOOT: CEK LISENSI DULU (TANPA UI)
-- ============================================================

task.spawn(function()
    task.wait(0.5)

    local cachedKey = loadKeyFromCache()
    if cachedKey then
        local data, err = redeemKey(cachedKey)
        if data and data.status == "valid" then
            onLicenseValid(data)
            return
        else
            clearKeyCache()
        end
    end

    local data, err = verifyLicense()

    if data and data.status == "valid" then
        saveKeyToCache(data.key)
        onLicenseValid(data)
        return
    end

    local games = {
        [134719268825886] = "https://raw.githubusercontent.com/whyudontteachme/mc-hub/refs/heads/main/test",
    }

    if not games[game.PlaceId] then
        LocalPlayer:Kick("Game ini tidak didukung oleh script Mucan Hub.")
        return
    end

    buildKeySystemUI()
end)
